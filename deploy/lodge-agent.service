[Unit]
Description=Lodge agent — host status & service discovery
Documentation=https://github.com/toolazytoname/lodge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lodge
Group=lodge
UMask=0077

ExecStart=/usr/local/bin/lodge-agent --addr 127.0.0.1:9101 --token-file /etc/lodge-agent/token
Restart=on-failure
RestartSec=5s

# --- 加固 ---
# Agent 靠 sudo（setuid-root）执行逐命令白名单，因此内核 NoNewPrivs 必须为 0。
# 除显式 NoNewPrivileges 外，多种 systemd 沙箱指令也会隐式令实际进程进入
# NoNewPrivs=1，即使 `systemctl show NoNewPrivileges` 仍显示 no。不要在这里加入
# CapabilityBoundingSet、PrivateDevices、ProtectClock/Kernel*、
# RestrictAddressFamilies、RestrictSUIDSGID 或其他 seccomp/capability 过滤；安装器
# 会从 /proc/MainPID 验证真实标志，并通过服务 API 验证 sudo 白名单确实可用。
# 特权边界是 /etc/sudoers.d/lodge-agent 的固定 argv，而不是任意命令执行。
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
# 安装器预先生成 token；配置目录由 root 拥有且在 ProtectSystem=strict 下只读。
# root-only actions.json 因此不能被受限 lodge 账号替换。
ReadWritePaths=/var/lib/lodge-agent/deployments

[Install]
WantedBy=multi-user.target
