[Unit]
Description=Lodge hub — central collector & API
Documentation=https://github.com/toolazytoname/lodge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lodge
Group=lodge
UMask=0077
ExecStart=/usr/local/bin/lodge-hub --addr 127.0.0.1:9102 --config /etc/lodge-hub/config.json --database /var/lib/lodge-hub/lodge.db --state /etc/lodge-hub/state.json --session-secret /etc/lodge-hub/session-secret --history-retention 720h
Restart=on-failure
RestartSec=5s
StateDirectory=lodge-hub
StateDirectoryMode=0700

# hub 不需要 sudo，所以可以上更严的加固（与 agent 不同）。
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
ReadWritePaths=/etc/lodge-hub /var/lib/lodge-hub

[Install]
WantedBy=multi-user.target
